# Modo de teste: true não posta nada no X. Troque para false só quando estiver pronto.
DRY_RUN=true

# Claude: usa a assinatura via `claude` (login local) ou CLAUDE_CODE_OAUTH_TOKEN no Actions.

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Crie o bot com o @BotFather. CHAT_ID: mande uma mensagem ao bot e veja em
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# App do X com permissão "Read and write"; tokens da SUA conta (OAuth 1.0a).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

RASCUNHOS_POR_EXECUCAO=3
PUBLICACOES_POR_EXECUCAO=1

# Opcional: chave grátis em developers.giphy.com. Sem ela o bot não oferece GIF.
GIPHY_API_KEY=
